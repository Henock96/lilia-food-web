# API — obligatoire en développement (CFG-001) : sans valeur, l'admin refuse
# de démarrer au lieu de retomber sur la production.
# Local : passer par le proxy /api-proxy (évite le CORS) vers un backend local.
NEXT_PUBLIC_API_URL=/api-proxy
# Cible du proxy /api-proxy (développement uniquement). Pointer la production
# ici est possible, mais doit rester un choix délibéré.
BACKEND_URL=http://localhost:8080

# Cloudinary : plus aucune variable côté client. Les uploads passent par
# `POST /upload/image` (backend authentifié) — cf. audit 2026-08-01, E-5.
# Les identifiants Cloudinary vivent uniquement dans l'env du backend.

# Firebase Client SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
