NEXT_PUBLIC_API_URL=https://lilia-backend.onrender.com

# ⚠️ NEXT_PUBLIC_MTN_NUMBER / NEXT_PUBLIC_AIRTEL_NUMBER ont été RETIRÉS.
# Le numéro d'encaissement et le montant à virer viennent désormais de la
# réponse de `POST /payments` (mode MANUAL uniquement), et le rail en service
# de `GET /payments/providers`. Une copie dans le front se périme sans que
# personne ne s'en aperçoive : le client virait sur un numéro obsolète.

# Firebase Client SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google Analytics 4 — format G-XXXXXXXXXX. Vide → aucun script chargé et
# `analytics.track()` ne fait rien (en développement, les événements sont
# affichés en console). À ne renseigner qu'en production, pour que les
# statistiques ne soient pas polluées par le développement local.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ⚠️ Ancien nom, toujours lu en repli pour ne pas éteindre la mesure au premier
# déploiement. Renseigner NEXT_PUBLIC_GA_MEASUREMENT_ID et retirer celui-ci une
# fois la variable Vercel renommée.
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity — rejeu de session et cartes de chaleur. Vide → aucun script
# chargé. Clarity ne reçoit que le NOM des événements, jamais leurs paramètres :
# il enregistre des sessions, et on n'y adjoint pas un montant ni un identifiant
# de commande. Voir docs/analytics.md.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Sentry — vide en local → SDK inactif. Renseigner en env vars Vercel.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=
# Build-only (upload des source maps) — env vars Vercel uniquement, jamais committées :
# SENTRY_ORG, SENTRY_PROJECT, SENTRY_AUTH_TOKEN
